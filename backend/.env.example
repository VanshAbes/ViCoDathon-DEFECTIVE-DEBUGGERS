# Copy this file to .env and fill in real values locally. Never commit .env.

# --- LLM provider (see src/llm/llmClient.js) ---
# One of: anthropic | openai | groq | ollama | openai-compatible
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Optional — set for OpenAI-compatible endpoints (local Ollama, Groq, etc).
# When set, LLM_API_KEY may be left blank for openai/openai-compatible.
LLM_BASE_URL=

# --- HTTP server ---
PORT=3000

# --- CORS ---
# Origin the React frontend is served from, e.g. http://localhost:5173
# Defaults to "*" if left blank (fine for local hackathon dev only).
FRONTEND_ORIGIN=
